# Hosted ERP demo on Render (see render.yaml at the repository root).
# Built with the repository root as context; Render routes traffic to $PORT.
FROM python:3.12-slim

COPY --from=ghcr.io/astral-sh/uv:latest /uv /bin/uv

RUN useradd --create-home --uid 1000 demo
USER demo
WORKDIR /home/demo/app

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    PATH="/home/demo/app/.venv/bin:$PATH"

COPY --chown=demo pyproject.toml uv.lock README.md LICENSE ./
COPY --chown=demo src/ ./src/
COPY --chown=demo examples/__init__.py ./examples/__init__.py
COPY --chown=demo examples/erp/ ./examples/erp/

# The project plus its default dependency group (Faker, used to seed the demo data), and
# uvicorn, which the library leaves to the host app.
RUN uv sync --locked --no-editable && uv pip install "uvicorn>=0.30"

# Throwaway SQLite database: every deploy, restart and spin-down starts from freshly seeded
# data. HYPERADMIN_SECRET_KEY and HYPERADMIN_ADMIN_PASSWORD are generated by render.yaml.
ENV HYPERADMIN_DEMO=1 \
    DATABASE_URL=sqlite+aiosqlite:////tmp/erp-demo.db \
    PORT=10000

EXPOSE 10000

CMD ["sh", "-c", "exec uvicorn examples.erp.main:app --host 0.0.0.0 --port \"$PORT\" --proxy-headers --forwarded-allow-ips '*'"]
